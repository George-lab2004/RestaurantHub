@model RestaurantHub.ViewModel.MenuItemViewModel

@{
    var isEdit = Model.Id != 0;
    ViewData["Title"] = isEdit ? "Edit Menu Item" : "New Menu Item";
}

<h2 class="mb-3">@ViewData["Title"]</h2>

<form asp-action="@(isEdit ? "Edit" : "Create")" method="post" enctype="multipart/form-data" style="max-width:600px">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="ExistingImageUrl" />

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="Price" class="form-label"></label>
            <input asp-for="Price" class="form-control" />
            <span asp-validation-for="Price" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="CategoryId" class="form-label"></label>
            <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select">
                <option value="0">-- Select category --</option>
            </select>
            <span asp-validation-for="CategoryId" class="text-danger"></span>
        </div>
    </div>

    <div class="mb-3 form-check">
        <input asp-for="IsAvailable" type="checkbox" class="form-check-input" />
        <label asp-for="IsAvailable" class="form-check-label"></label>
    </div>

    <div class="mb-3">
        <label asp-for="ImageFile" class="form-label"></label>
        @if (!string.IsNullOrEmpty(Model.ExistingImageUrl))
        {
            <div class="mb-2">
                <img src="@Model.ExistingImageUrl" alt="Current image" style="height:80px;border-radius:6px;" />
                <div class="form-text">Current image. Choose a file only if you want to replace it.</div>
            </div>
        }
        <input asp-for="ImageFile" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
        <span asp-validation-for="ImageFile" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}