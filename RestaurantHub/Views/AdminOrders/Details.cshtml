@model AdminOrderDetailsViewModel

@{
    ViewData["Title"] = $"Order #{Model.Id}";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Order #@Model.Id <partial name="_StatusBadge" model="Model.Status" /></h2>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to orders</a>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <table class="table">
            <thead>
                <tr><th>Item</th><th>Qty</th><th class="text-end">Price</th><th class="text-end">Total</th></tr>
            </thead>
            <tbody>
                @foreach (var line in Model.Lines)
                {
                    <tr>
                        <td>@line.ItemName</td>
                        <td>@line.Quantity</td>
                        <td class="text-end">@line.UnitPrice.ToString("N2")</td>
                        <td class="text-end">@line.LineTotal.ToString("N2")</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="ms-auto" style="max-width:300px">
            <div class="d-flex justify-content-between"><span>Subtotal</span><span>@Model.Subtotal.ToString("N2") EGP</span></div>
            <div class="d-flex justify-content-between"><span>Tax</span><span>@Model.Tax.ToString("N2") EGP</span></div>
            <hr />
            <div class="d-flex justify-content-between fw-bold"><span>Total</span><span>@Model.TotalPrice.ToString("N2") EGP</span></div>
        </div>

        <h5 class="mt-4">Status history</h5>
        @if (!Model.History.Any())
        {
            <p class="text-muted">No history recorded for this order.</p>
        }
        else
        {
            <ul class="list-group">
                @foreach (var h in Model.History)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span><partial name="_StatusBadge" model="h.Status" /> <span class="text-muted small ms-2">by @h.ChangedByName</span></span>
                        <span class="text-muted small">@h.ChangedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</span>
                    </li>
                }
            </ul>
        }
    </div>

    <div class="col-lg-5">
        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title">Customer and delivery</h5>
                <p class="mb-1"><strong>Name:</strong> @Model.CustomerName</p>
                <p class="mb-1"><strong>Email:</strong> @Model.CustomerEmail</p>
                <p class="mb-1"><strong>Phone:</strong> @Model.Phone</p>
                <p class="mb-1"><strong>Address:</strong> @Model.DeliveryAddress</p>
                <p class="mb-1"><strong>Payment:</strong> @Model.PaymentMethod</p>
                <p class="mb-1"><strong>Placed:</strong> @Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</p>
                @if (!string.IsNullOrWhiteSpace(Model.Notes))
                {
                    <p class="mb-0"><strong>Notes:</strong> @Model.Notes</p>
                }
            </div>
        </div>

        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Update status</h5>
                @if (!Model.AllowedNextStatuses.Any())
                {
                    <p class="text-muted mb-0">This order is closed. No further changes are possible.</p>
                }
                else
                {
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var next in Model.AllowedNextStatuses)
                        {
                            <form asp-action="ChangeStatus" asp-route-id="@Model.Id" method="post"
                                  onsubmit="@(next == OrderStatus.Cancelled ? "return confirm('Cancel this order?');" : "")">
                                <input type="hidden" name="newStatus" value="@next" />
                                <button type="submit" class="btn btn-sm @(next == OrderStatus.Cancelled ? "btn-outline-danger" : "btn-primary")">
                                    @(next == OrderStatus.Cancelled ? "Cancel order" : $"Mark as {next}")
                                </button>
                            </form>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>