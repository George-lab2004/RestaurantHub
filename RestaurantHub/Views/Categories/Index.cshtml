@model List<RestaurantHub.ViewModel.CategoryListItemViewModel>

@{
    ViewData["Title"] = "Categories";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Categories</h2>
    <a asp-action="Create" class="btn btn-primary">+ New Category</a>
</div>

<table class="table table-hover align-middle">
    <thead>
        <tr>
            <th style="width:80px">Image</th>
            <th>Name</th>
            <th>Menu items</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>
                    @if (!string.IsNullOrEmpty(c.ImageUrl))
                    {
                        <img src="@c.ImageUrl" alt="@c.Name" style="height:48px;width:48px;object-fit:cover;border-radius:6px;" />
                    }
                </td>
                <td>@c.Name</td>
                <td>@c.ItemsCount</td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                    <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline"
                          onsubmit="return confirm('Delete this category?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <p class="text-muted">No categories yet. Create the first one.</p>
}