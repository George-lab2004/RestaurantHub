@model List<MyOrderListItemViewModel>

@{
    ViewData["Title"] = "My Orders";
}

<h2 class="mb-3">My Orders</h2>

@if (!Model.Any())
{
    <p class="text-muted">You haven't placed any orders yet.</p>
    <a asp-controller="Menu" asp-action="Index" class="btn btn-primary">Browse the menu</a>
}
else
{
    <table class="table table-hover align-middle">
        <thead>
            <tr><th>Order</th><th>Date</th><th>Items</th><th>Total</th><th>Status</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var o in Model)
            {
                <tr>
                    <td>#@o.Id</td>
                    <td>@o.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</td>
                    <td>@o.ItemsCount</td>
                    <td>@o.TotalPrice.ToString("N2") EGP</td>
                    <td><partial name="_StatusBadge" model="o.Status" /></td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@o.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}