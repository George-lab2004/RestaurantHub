@model OrderDetailsViewModel

@{
    ViewData["Title"] = $"Order #{Model.Id}";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Order #@Model.Id <partial name="_StatusBadge" model="Model.Status" /></h2>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to my orders</a>
</div>

<div class="row g-4">
    <div class="col-md-7">
        <table class="table">
            <thead>
                <tr><th>Item</th><th>Qty</th><th class="text-end">Price</th><th class="text-end">Total</th></tr>
            </thead>
            <tbody>
                @foreach (var line in Model.Lines)
                {
                    <tr>
                        <td>@line.ItemName</td>
                        <td>@line.Quantity</td>
                        <td class="text-end">@line.UnitPrice.ToString("N2")</td>
                        <td class="text-end">@line.LineTotal.ToString("N2")</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="ms-auto" style="max-width:300px">
            <div class="d-flex justify-content-between"><span>Subtotal</span><span>@Model.Subtotal.ToString("N2") EGP</span></div>
            <div class="d-flex justify-content-between"><span>Tax</span><span>@Model.Tax.ToString("N2") EGP</span></div>
            <hr />
            <div class="d-flex justify-content-between fw-bold"><span>Total</span><span>@Model.TotalPrice.ToString("N2") EGP</span></div>
        </div>

        <h5 class="mt-4">Status history</h5>
        @if (!Model.History.Any())
        {
            <p class="text-muted">No history recorded for this order.</p>
        }
        else
        {
            <ul class="list-group">
                @foreach (var h in Model.History)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <partial name="_StatusBadge" model="h.Status" />
                        <span class="text-muted small">@h.ChangedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</span>
                    </li>
                }
            </ul>
        }
    </div>

    <div class="col-md-5">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Delivery details</h5>
                <p class="mb-1"><strong>Placed:</strong> @Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</p>
                <p class="mb-1"><strong>Address:</strong> @Model.DeliveryAddress</p>
                <p class="mb-1"><strong>Phone:</strong> @Model.Phone</p>
                <p class="mb-1"><strong>Payment:</strong> @Model.PaymentMethod</p>
                @if (!string.IsNullOrWhiteSpace(Model.Notes))
                {
                    <p class="mb-0"><strong>Notes:</strong> @Model.Notes</p>
                }

                @if (Model.CanCancel)
                {
                    <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" class="mt-3"
                          onsubmit="return confirm('Cancel this order?');">
                        <button type="submit" class="btn btn-outline-danger w-100">Cancel order</button>
                    </form>
                }